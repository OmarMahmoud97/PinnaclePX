{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Scaffold modules with no consumer yet. Remove each entry as soon as the pipeline imports it.
  "entry": [
    "lib/db/client.ts",
    "lib/db/schema.ts",
    "drizzle.config.ts",
    // Template components are rendered by the preview page once it lands.
    "templates/*/index.tsx",
  ],
  // drizzle.config.ts imports lib/env, which throws without a full .env.local, so Knip must not
  // load it. The config and schema paths are listed under entry above instead.
  "drizzle": false,
  // sharp is opted out of bundling in next.config.ts and is imported by lib/images once the
  // imagery stage lands.
  "ignoreDependencies": ["sharp"],
}
