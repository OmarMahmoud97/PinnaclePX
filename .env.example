# Copy to .env.local for local development, or run `vercel env pull .env.local`.
# Every variable is validated in lib/env.ts; the app fails fast at build time if one is missing.

# Server
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
ANTHROPIC_API_KEY=
# Only for an identity-linked key (Console > Settings > Workspaces); leave unset otherwise.
ANTHROPIC_WORKSPACE_ID=
PEXELS_API_KEY=
HMAC_SECRET=replace-with-at-least-32-random-characters
BLOB_READ_WRITE_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
# "PinnaclePX <hello@your-domain>" once the domain is verified in Resend; unset, the test sender is used.
RESEND_FROM=
# Where the notice of every build goes: the links, the client's answers and the tokens it cost.
OWNER_EMAIL=

# Local pipeline. The Inngest SDK reads this itself: with it set, events go to the dev server
# started by `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`, not to the cloud.
INNGEST_DEV=1
# Development only: set to 1 and an address may be shown a template it has already seen, so one
# email can test the same template repeatedly. A production deployment refuses to build with it.
ALLOW_REPEAT_TEMPLATES=
# Production only, once the page takes traffic: set to 1 and the build fails while fewer
# templates are ready than the three designs the home page promises. Leave empty elsewhere.
LAUNCH_GATE=

# Client
NEXT_PUBLIC_APP_URL=http://localhost:3000
