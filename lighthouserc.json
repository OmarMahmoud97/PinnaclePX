{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/", "http://localhost:3000/start"],
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 5,
      "settings": { "preset": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 230000 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 500000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 600000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 4 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
