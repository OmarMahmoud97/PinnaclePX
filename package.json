    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/speed-insights": "2.0.0",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "drizzle-orm": "0.45.2",
    "gsap": "3.15.0",
    "inngest": "4.18.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
