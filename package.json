{
  "name": "pinnaclepx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "lefthook install",
    "budget": "node scripts/bundle-budget.mjs",
    "measure:colour": "python scripts/imgstats.py",
    "measure:ground": "node scripts/pool.mjs",
    "capture:work": "node scripts/capture-work.mjs",
    "template:compare": "node scripts/template-compare.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:shots": "node tests/eval/screenshots.mjs",
    "eval:scorecard": "node tests/eval/scorecard.mjs",
    "check:text-fit": "node scripts/checks/text-fit.mjs",
    "check:over-picture": "node scripts/checks/over-picture.mjs",
    "check:contrast": "node scripts/checks/contrast.mjs",
    "check:gradient-text": "node scripts/checks/gradient-text.mjs",
    "check:behaviour": "node scripts/checks/behaviour.mjs",
    "check:menus": "node scripts/checks/menus.mjs",
    "check:studio-bar": "node scripts/checks/studio-bar.mjs",
    "check:layout-shift": "node scripts/checks/layout-shift.mjs",
    "check:a11y-names": "node scripts/checks/a11y-names.mjs",
    "check:leftovers": "node scripts/checks/leftovers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@neondatabase/serverless": "1.2.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/speed-insights": "2.0.0",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "drizzle-orm": "0.45.3",
    "gsap": "3.15.0",
    "inngest": "4.21.1",
    "lenis": "1.3.26",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "undici@>=6.0.0 <6.28.1": "6.28.1",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21"
    }
  }
}
